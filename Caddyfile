:{$PORT:8080} {
  root * /srv
  encode zstd gzip

  @immutable path /assets/* /canvaskit/* /*.js /*.wasm /*.woff /*.woff2 /*.ttf
  header @immutable Cache-Control "public, max-age=31536000, immutable"
  header /index.html Cache-Control "no-cache, no-store, must-revalidate"
  header {
    Content-Security-Policy "default-src 'self' data: blob:; connect-src 'self' https://images.pexels.com; img-src 'self' data: blob: https://images.pexels.com; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:;"
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
  }

  try_files {path} {path}/ /index.html
  file_server
}
