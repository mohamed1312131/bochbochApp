{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dido (dev)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define-from-file=dart_defines/dev.json"
      ]
    },
    {
      "name": "dido (dev, release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": [
        "--dart-define-from-file=dart_defines/dev.json"
      ]
    },
    {
      "name": "DIDO static demo (Chrome)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "program": "lib/main_demo.dart",
      "args": [
        "--dart-define=DIDO_DEMO_MODE=true"
      ]
    }
  ]
}
